// proxy/d3d9.rc - version resource so the DLL identifies itself in Explorer and
// in crash tools. The game's own DirectX check reads the registry, not this.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "The Darkness II VR mod (d3d9 proxy module)"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "d3d9"
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", "Darkness II VR"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
